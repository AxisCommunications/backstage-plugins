{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AxisCommunications/backstage-plugins"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--no-node-snapshot backstage-cli repo start",
    "dev-next": "npx backstage-cli repo start backend app-next",
    "start": "yarn workspace app start",
    "start-backend": "backstage-cli repo start packages/backend",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build",
    "build-image": "yarn workspace backend build-image",
    "build:api-reports": "yarn build:api-reports:only --tsc",
    "build:api-reports:only": "backstage-repo-tools api-reports -o ae-wrong-input-file-type --validate-release-tags",
    "build:catalog-info": "yarn backstage-repo-tools generate-catalog-info",
    "build:knip-reports": "backstage-repo-tools knip-reports",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix --publish",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "pack": "yarn workspaces foreach -A -v pack",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "release": "changeset version && yarn prettier --write '{packages,plugins}/*/package.json' && yarn install --no-immutable",
    "publish:github": "yarn tsc && yarn build:all && yarn workspaces foreach -A -v --no-private npm publish --access public --tolerate-republish",
    "new": "backstage-cli new --scope internal"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "plugins/*"
    ]
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.4",
    "@backstage/cli-defaults": "^0.1.4",
    "@backstage/e2e-test-utils": "^0.1.2",
    "@backstage/repo-tools": "^0.18.0",
    "@changesets/cli": "^2.28.1",
    "@jest/environment-jsdom-abstract": "^30.2.0",
    "@playwright/test": "^1.39.0",
    "@spotify/prettier-config": "^15.0.0",
    "@types/jest": "^30",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^24.0.0",
    "jest": "^30.2.0",
    "jsdom": "^27",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "typescript": "~5.9.0"
  },
  "resolutions": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "qs": "^6.14.1"
  },
  "prettier": "@spotify/prettier-config",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.18.0"
}
